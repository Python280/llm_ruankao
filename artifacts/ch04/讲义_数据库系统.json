   "子节点": [
    {
     "类型": "内容",
     "内容": "规范化理论基本概念"
    },
    {
     "类型": "内容",
     "内容": "部分函数依赖"
    },
    {
     "类型": "内容",
     "内容": "关系模式：R1（A，B，C，D）"
    },
    {
     "类型": "内容",
     "内容": "依赖集：{AB → D，A → C}"
    },
    {
     "类型": "图",
     "内容": "[图] 部分函数依赖示意图：圆圈节点A、B、C、D，A指向C，A和B共同指向D，橙色箭头标注部分函数依赖并指向A→C的边"
