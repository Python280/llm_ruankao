  {
   "内容": "规范化理论",
   "类型": "标题",
   "层级": 1,
   "页": 13,
   "子节点": [
    {
     "类型": "内容",
     "内容": "Armstrong公理"
    },
    {
     "类型": "内容",
     "内容": "关系模式R <U，F >来说有以下的推理规则："
    },
    {
     "类型": "内容",
     "内容": "A1.自反律（Reflexivity）：若Y⊆X⊆U，则X →Y成立。"
    },
    {
     "类型": "内容",
     "内容": "A2.增广律（Augmentation）：若Z⊆U且X→Y，则XZ→YZ成立。"
    },
    {
     "类型": "内容",
     "内容": "A3.传递律（Transitivity）：若X→Y且Y→Z，则X→Z成立。"
    },
    {
     "类型": "内容",
     "内容": "根据A1，A2，A3这三条推理规则可以得到下面三条推理规则："
    },
    {
     "类型": "内容",
     "内容": "合并规则：由X→Y，X→Z，有X→YZ。（A2，A3）"
    },
    {
     "类型": "内容",
     "内容": "伪传递规则：由X→Y，WY→Z，有XW→Z。（A2，A3）"
    },
    {
     "类型": "内容",
     "内容": "分解规则：由X→Y及 Z ⊆ Y，有X→Z。（A1，A3）"
    }
   ]
  },
  {
   "内容": "规范化理论",
   "类型": "标题",
   "层级": 1,
   "页": 14,
   "子节点": [
    {
     "类型": "内容",
     "内容": "Armstrong公理"
    },
    {
     "类型": "内容",
     "内容": "根据A1，A2，A3这三条推理规则可以得到下面三条推理规则："
    },
    {
     "类型": "内容",
     "内容": "合并规则：由X→Y，X→Z，有X→YZ。（A2，A3）"
    },
    {
     "类型": "内容",
     "内容": "证明：X→Y —A2→ X→XY；X→Z —A2→ XY→YZ；二者经A3得 X→YZ"
    },
    {
     "类型": "内容",
     "内容": "伪传递规则：由X→Y，WY→Z，有XW→Z。（A2，A3）"
    },
    {
     "类型": "内容",
     "内容": "证明：X→Y —A2→ WX→WY；WY→Z；二者经A3得 WX→Z"
